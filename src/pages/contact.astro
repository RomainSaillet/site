---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact — Romain Saillet"
  description="Écrire à Romain Saillet pour un atelier Storygami, un projet éditorial, ou une collaboration."
  activeNav="contact"
>

  <section class="container hero">
    <div class="section-eyebrow">Contact</div>
    <h1 style="max-width:16ch;">Une idée, un projet, une question.</h1>
    <p class="standfirst">
      Je réponds à tout ce qui mérite une réponse. Pour un atelier Storygami, une
      conférence, une collaboration éditoriale, ou simplement une conversation —
      écrivez-moi directement.
    </p>
  </section>

  <section class="container section" style="border-top:none;padding-top:0;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-10);align-items:start;">
      <div>
        <form class="contact-form" onsubmit="return false;">
          <div class="field">
            <label for="nom">Nom</label>
            <input type="text" id="nom" name="nom" placeholder="Votre nom">
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="votre@email.com">
          </div>
          <div class="field">
            <label for="sujet">Sujet</label>
            <input type="text" id="sujet" name="sujet" placeholder="Atelier Storygami, conférence, collaboration…">
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" placeholder="Ce que vous avez en tête."></textarea>
          </div>
          <div>
            <button type="submit" class="btn btn-primary">Envoyer →</button>
          </div>
        </form>
      </div>
      <div>
        <div style="padding-top:var(--space-2);">
          <h3 style="font-family:var(--font-serif);font-size:22px;font-weight:500;margin:0 0 var(--space-4);">Ce pour quoi on m'écrit le plus souvent</h3>
          <div style="display:flex;flex-direction:column;gap:var(--space-5);">
            <div style="padding-top:var(--space-4);border-top:1px solid var(--rule);">
              <div class="section-eyebrow" style="margin-bottom:6px;">Ateliers Storygami</div>
              <p style="font-family:var(--font-serif);font-size:16px;line-height:1.5;color:var(--ink-muted);margin:0;">Demi-journée ou journée complète pour une équipe, un dirigeant, ou un expert qui veut structurer sa prise de parole.</p>
            </div>
            <div style="padding-top:var(--space-4);border-top:1px solid var(--rule);">
              <div class="section-eyebrow" style="margin-bottom:6px;">Conférences</div>
              <p style="font-family:var(--font-serif);font-size:16px;line-height:1.5;color:var(--ink-muted);margin:0;">Je parle de storytelling de marque, de nouveaux médias, et de ce que l'IA change — ou ne change pas — au récit.</p>
            </div>
            <div style="padding-top:var(--space-4);border-top:1px solid var(--rule);">
              <div class="section-eyebrow" style="margin-bottom:6px;">Collaboration éditoriale</div>
              <p style="font-family:var(--font-serif);font-size:16px;line-height:1.5;color:var(--ink-muted);margin:0;">Pour des projets ponctuels avec des marques, des fondations, ou des personnes publiques.</p>
            </div>
          </div>
          <div style="margin-top:var(--space-7);">
            <div class="section-eyebrow" style="margin-bottom:8px;">Email direct</div>
            <a href="mailto:romain@romainsaillet.com" style="font-family:var(--font-serif);font-size:18px;">romain@romainsaillet.com</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
