---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getSubstackPosts } from '../../lib/substack.js';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const ALL_TAGS = ['Tribunes', 'Actualite', 'Videos'];

const substackPosts = await getSubstackPosts('https://romainsaillet.substack.com/feed', 5);
---
<Base
  title="Blog - Romain Saillet"
  description="Articles de fond sur l'editorial, les medias et la transformation narrative par la technologie."
  activeNav="blog"
>

  <section class="container hero">
    <div class="section-eyebrow">Blog</div>
    <h1 style="max-width:20ch;">Ce que j'ecris quand je ne peux pas m'en empecher.</h1>
    <p class="standfirst">
      Des articles de fond sur l'editorial, les medias, et ce que la technologie
      change a la facon dont on raconte et dont on recoit les histoires.
      Pas de calendrier editorial. Seulement quand ca vaut le detour.
    </p>
  </section>

  <!-- ===== MODULE NEWSLETTER ===== -->
  <section class="container section" style="border-top:none;padding-top:0;">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">Newsletter</div>
        <h2 class="section-title">La newsletter du recit</h2>
        <p style="font-family:var(--font-serif);font-size:18px;line-height:1.6;color:var(--ink-muted);margin:12px 0 0;max-width:38rem;">
          Chaque semaine, une lecture sur le recit, les medias et ce que la
          technologie leur fait. Du concret, des cas, des prises de position.
          Pas de calendrier impose : seulement quand ca vaut le detour.
        </p>
      </div>
      <a class="btn btn-primary"
         href="https://romainsaillet.substack.com"
         target="_blank" rel="noopener noreferrer">
        S'abonner
      </a>
    </div>
  </section>

  <!-- ===== DERNIERES EDITIONS (RSS Substack) ===== -->
  {substackPosts.length > 0 && (
    <section class="container section">
      <div class="section-head">
        <div>
          <div class="section-eyebrow">Newsletter</div>
          <h2 class="section-title">Dernieres editions</h2>
        </div>
        <a class="section-link"
           href="https://romainsaillet.substack.com"
           target="_blank" rel="noopener noreferrer">
          Toutes les editions ↗
        </a>
      </div>
      {substackPosts.map(post => (
        <a class="article-card"
           href={post.link}
           target="_blank" rel="noopener noreferrer">
          <div
            class={`ac-cover${post.image ? '' : ' storygami'}`}
            style={post.image
              ? `background-image:url('${post.image}');background-size:cover;background-position:center top;`
              : undefined}
            aria-hidden="true"
          ></div>
          <div>
            <div class="ac-meta">
              Newsletter<span class="sep"></span>{post.date}
            </div>
            <h3 class="ac-title">{post.title}</h3>
            {post.description && <p class="ac-dek">{post.description}</p>}
          </div>
        </a>
      ))}
    </section>
  )}

  <!-- ===== ARCHIVE LOCALE (inchangee) ===== -->
  <section class="container section" style="border-top:none;padding-top:0;">

    <div class="tag-filter-bar">
      <button class="tag-filter active" data-filter="all">Tout</button>
      {ALL_TAGS.map(tag => (
        <button class="tag-filter" data-filter={tag}>{tag}</button>
      ))}
    </div>

    <div id="article-list">
      {posts.map(post => (
        <a
          class="article-card"
          href={`/blog/${post.slug}`}
          data-tags={(post.data.tags ?? []).join(',')}
        >
          <div class={`ac-cover ${post.data.cover ?? ''}`}></div>
          <div>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="ac-tags">
                {post.data.tags.map(tag => <span class="ac-tag">{tag}</span>)}
              </div>
            )}
            <div class="ac-meta">
              {post.data.readTime}<span class="sep"></span>
              {post.data.date.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })}
            </div>
            <h3 class="ac-title">{post.data.title}</h3>
            <p class="ac-dek">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>

  </section>

</Base>

<script>
  const btns  = document.querySelectorAll('.tag-filter');
  const cards = document.querySelectorAll('#article-list .article-card');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      cards.forEach(card => {
        const tags = (card.dataset.tags || '').split(',').filter(Boolean);
        const show = filter === 'all' || tags.includes(filter);
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
