---
import Base from '../layouts/Base.astro';
---
<Base
  title="Romain Saillet — Éditorial, enseignement, et un peu de code."
  description="Expert en création éditoriale et nouveaux médias. Directeur Conseil Éditorial chez Mantu, enseignant à Paris Panthéon-Assas, créateur de Storygami et Gist It."
  activeNav="accueil"
>

  <!-- ═══ HERO ═══ -->
  <section class="hero-fs">

    <div class="hero-bg" id="heroBg"></div>

    <div class="hero-body container">
      <div class="hero-text">
        <p class="hero-eyebrow">Romain Saillet</p>
        <h1 class="hero-title">
          Concevoir des histoires mémorables pour
          <span class="hero-rotating-container">
            <span class="hero-rotating-wrap"><span class="hero-rotating-text" id="heroRotating">engager vos audiences</span></span>
            <span class="hero-dot" id="heroDot">.</span>
          </span>
        </h1>
        <a href="/contact" class="hero-cta">Me contacter →</a>
      </div>
    </div>



    <a href="#hero-end" class="hero-scroll" aria-label="Défiler vers le contenu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
    </a>

  </section>
  <div id="hero-end"></div>

  <!-- ═══ À PROPOS ═══ -->
  <section class="container section-about">
    <div class="about-inner">
      <div class="about-text">
        <div class="section-eyebrow">À propos</div>
        <h2 class="about-title">Romain Saillet</h2>
        <p class="about-body">
          Après avoir dirigé mon agence de communication éditoriale Story Tailor,
          j'ai rejoint Mantu en tant que Directeur Conseil Éditorial.
        </p>
        <p class="about-body">
          Passionné par les nouvelles narrations, j'accompagne depuis 15 ans des marques,
          des dirigeants et des collaborateurs à mettre en forme leurs récits pour engager
          leurs audiences et atteindre leurs objectifs.
        </p>
        <a href="/contact" class="about-cta">Me contacter →</a>
      </div>
      <div class="about-photo-wrap">
        <img
          src="/romain-saillet.jpg"
          alt="Romain Saillet"
          class="about-photo"
          width="420"
          height="560"
        />
        <p class="about-credit">
          © Quentin Chevrier
          <a href="https://www.instagram.com/quentin_che/" target="_blank" rel="noopener" class="about-credit-ig" aria-label="Instagram de Quentin Chevrier">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </p>
      </div>
    </div>
  </section>



  <!-- ═══ OFFRES ═══ -->
  <section class="container section-offres">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">Offres</div>
        <h2 class="section-title">Trois niveaux d'intervention</h2>
      </div>
      <a class="section-link" href="/offre">Toutes les offres →</a>
    </div>
    <div class="offres-home-grid">

      <a class="offre-home-card" href="/offre#strategie">
        <div class="ohc-num">01</div>
        <div class="ohc-body">
          <h3 class="ohc-title">Stratégie</h3>
          <p class="ohc-dek">Poser les fondations. Comprendre pourquoi, pour qui et avec quelle voix — avant de produire quoi que ce soit.</p>
          <span class="ohc-link">Workshop Storygami · Stratégie éditoriale →</span>
        </div>
      </a>

      <a class="offre-home-card" href="/offre#tactique">
        <div class="ohc-num">02</div>
        <div class="ohc-body">
          <h3 class="ohc-title">Tactique</h3>
          <p class="ohc-dek">Mettre en mouvement. Concevoir les dispositifs qui transforment une stratégie en production régulière et mesurable.</p>
          <span class="ohc-link">Content Factory · GEO →</span>
        </div>
      </a>

      <a class="offre-home-card" href="/offre#production">
        <div class="ohc-num">03</div>
        <div class="ohc-body">
          <h3 class="ohc-title">Production</h3>
          <p class="ohc-dek">Passer à l'air. Créer des formats qui durent, se répètent, et construisent une audience dans la durée.</p>
          <span class="ohc-link">Podcast interne · Webinaire →</span>
        </div>
      </a>

    </div>
  </section>

  <!-- ═══ DERNIERS ARTICLES ═══ -->
  <section class="container section" style="border-top:none;padding-top:0;">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">Derniers articles</div>
        <h2 class="section-title">Ce que j'ai écrit récemment</h2>
      </div>
      <a class="section-link" href="/blog">Tous les articles →</a>
    </div>
    <a class="article-card" href="/blog/ia-ecrira-pas-votre-livre">
      <div class="ac-cover storygami"></div>
      <div>
        <div class="ac-meta">Tribune<span class="sep"></span>12 min<span class="sep"></span>novembre 2025</div>
        <h3 class="ac-title">Pourquoi l'IA n'écrira pas votre prochain livre (et c'est tant mieux)</h3>
        <p class="ac-dek">Une grammaire ne fait pas un récit. Un récit ne fait pas un livre. Et un livre n'est rien sans le lecteur qu'il choisit.</p>
      </div>
    </a>
    <a class="article-card" href="/blog/nouveaux-medias-nouveaux-recits">
      <div class="ac-cover tedx"></div>
      <div>
        <div class="ac-meta">Tribune<span class="sep"></span>8 min<span class="sep"></span>septembre 2025</div>
        <h3 class="ac-title">Les nouveaux médias n'existent pas. Il n'y a que de nouveaux récits.</h3>
        <p class="ac-dek">Le mot « nouveau » est usé jusqu'à la corde. Ce qui change vraiment, ce n'est pas le canal.</p>
      </div>
    </a>
    <a class="article-card" href="/blog/enseigner-editorial-chatgpt">
      <div class="ac-cover teach"></div>
      <div>
        <div class="ac-meta">Cours<span class="sep"></span>6 min<span class="sep"></span>juin 2025</div>
        <h3 class="ac-title">Enseigner l'éditorial à des étudiants nés avec ChatGPT</h3>
        <p class="ac-dek">Retour sur un semestre à Paris Panthéon-Assas. Ce que mes étudiants m'ont appris vaut largement ce que je leur ai transmis.</p>
      </div>
    </a>
  </section>

  <!-- ═══ CITATION ═══ -->
  <section class="container section">
    <blockquote class="pullquote" style="max-width:32rem;">
      « Une marque qui n'a plus rien à raconter n'a plus rien à vendre. C'est aussi vrai d'une personne. »
      <cite>Storygami — chapitre I</cite>
    </blockquote>
  </section>

</Base>

<style>
  /* ══════════════════════════════════
     HERO — variables CSS par thème
  ══════════════════════════════════ */

  /* Mode sombre (défaut) */
  .hero-fs {
    --hero-base-start : #1c0f0a;
    --hero-base-end   : #18160F; /* = --paper dark, assure la continuité */
    --hero-orb-color  : rgba(170, 80, 50, 0.60);
    --hero-orb-mid    : rgba(100, 38, 20, 0.30);
    --hero-glow-color : rgba(210, 115, 65, 0.18);
    --hero-text       : #ffffff;
    --hero-text-dim   : rgba(255,255,255,0.50);
    --hero-cta-bg     : rgba(255,255,255,0.10);
    --hero-cta-border : rgba(255,255,255,0.22);
    --hero-cta-hover  : rgba(255,255,255,0.18);
  }

  /* Mode clair */
  :global([data-theme="light"]) .hero-fs {
    --hero-base-start : #fdf6ee;
    --hero-base-end   : #f5ece0;
    --hero-orb-color  : rgba(200, 130, 70, 0.35);
    --hero-orb-mid    : rgba(180, 100, 50, 0.15);
    --hero-glow-color : rgba(220, 155, 90, 0.20);
    --hero-text       : #1a0f0a;
    --hero-text-dim   : rgba(26, 15, 10, 0.45);
    --hero-cta-bg     : rgba(26, 15, 10, 0.07);
    --hero-cta-border : rgba(26, 15, 10, 0.18);
    --hero-cta-hover  : rgba(26, 15, 10, 0.13);
  }

  /* ── Structure ── */
  .hero-fs {
    position: relative;
    height: 100vh;
    min-height: 620px;
    overflow: hidden;
  }

  /* Fondu bas vers la couleur de page — seamless en dark & light */
  .hero-fs::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 180px;
    background: linear-gradient(to bottom,
      transparent,
      var(--hero-base-end)
    );
    pointer-events: none;
  }

  /* ── Fond réactif à la souris via CSS custom props ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 70% 55% at var(--hx, 50%) var(--hy, 62%),
        var(--hero-orb-color) 0%,
        var(--hero-orb-mid)   38%,
        transparent           70%
      ),
      radial-gradient(
        ellipse 40% 30% at var(--hx, 50%) var(--hy, 62%),
        var(--hero-glow-color) 0%,
        transparent 100%
      ),
      linear-gradient(160deg,
        var(--hero-base-start) 0%,
        var(--hero-base-end)   100%
      );
    transition: background 0.4s ease;
  }

  /* ── Texte ── */
  .hero-body {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  .hero-text {
    max-width: 680px;
    padding-top: 60px;
    text-align: left;
  }
  .hero-eyebrow {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hero-text-dim);
    margin-bottom: 24px;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--hero-text);
    margin-bottom: 40px;
  }
  .hero-cta {
    display: inline-block;
    padding: 13px 28px;
    background: var(--hero-cta-bg);
    border: 1px solid var(--hero-cta-border);
    color: var(--hero-text);
    font-weight: 500;
    font-size: 14px;
    border-radius: 20px;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: background 0.2s, border-color 0.2s;
  }
  .hero-cta:hover {
    background: var(--hero-cta-hover);
  }


  /* ── Badge TEDx — droite ── */

  /* ── Flèche scroll — bas centre ── */
  .hero-scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--hero-cta-bg);
    border: 1px solid var(--hero-cta-border);
    border-radius: 50%;
    color: var(--hero-text);
    text-decoration: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: bounce 2.4s ease-in-out infinite;
    transition: background 0.2s, border-color 0.2s;
  }
  .hero-scroll:hover {
    background: var(--hero-cta-hover);
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }

  /* ── Texte rotatif ── */

  /* Couleur accent selon le thème */
  .hero-fs { --hero-accent: #C96848; }

  /* Conteneur de la ligne rotative — référence pour le point absolu */
  .hero-rotating-container {
    display: block;
    position: relative;
    height: 1.15em;  /* hauteur = une ligne, évite le saut de layout */
  }

  /* Fenêtre de clip du texte animé */
  .hero-rotating-wrap {
    display: inline-block;
    overflow: hidden;
    height: 1.12em;
    vertical-align: bottom;
  }

  .hero-rotating-text {
    display: block;
    white-space: nowrap;
    color: var(--hero-accent);
  }

  /* Point absolu — glisse via `left` animé en JS */
  .hero-dot {
    position: absolute;
    bottom: 0;
    left: 0;           /* valeur initiale, mise à jour par JS */
    color: var(--hero-accent);
    font-weight: 700;
    transition: left 0.45s cubic-bezier(0.2, 0, 0, 1);
    pointer-events: none;
  }

  .hero-rotating-text.is-entering {
    animation: rotateIn 0.45s cubic-bezier(0.2, 0, 0, 1) forwards;
  }
  .hero-rotating-text.is-leaving {
    animation: rotateOut 0.35s cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  @keyframes rotateIn {
    from { transform: translateY(110%); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }
  @keyframes rotateOut {
    from { transform: translateY(0);     opacity: 1; }
    to   { transform: translateY(-110%); opacity: 0; }
  }

  /* ── Section about ── */
  .section-about {
    padding: var(--space-9) 0;
    border-top: 1px solid var(--rule);
  }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 64px;
    align-items: center;
  }
  .about-photo-wrap {
    position: relative;
  }
  .about-photo {
    width: 100%;
    max-height: 420px;
    border-radius: 20px;
    display: block;
    object-fit: cover;
    object-position: center top;
    aspect-ratio: 3/4;
  }
  .about-credit {
    margin-top: 8px;
    font-size: 11px;
    color: var(--ink-faint);
    font-family: var(--font-sans);
    letter-spacing: 0.04em;
    text-align: right;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }
  .about-credit-ig {
    color: var(--ink-faint);
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }
  .about-credit-ig:hover { color: var(--ember); }
  .about-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 12px 0 28px;
  }
  .about-body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-muted);
    margin-bottom: 20px;
    max-width: 480px;
  }
  .about-cta {
    display: inline-block;
    margin-top: 12px;
    padding: 11px 24px;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .about-cta:hover { background: #2A2722; }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .hero-title { font-size: 1.9rem; }
    .hero-rotating-wrap { height: 1.2em; }
  }
</style>

<script>
  /* ── Texte rotatif + point glissant ── */
  const phrases = [
    "engager vos audiences",
    "développer votre marque",
    "trouver vos clients",
    "embaucher les meilleurs talents",
    "inspirer vos équipes",
    "convaincre vos investisseurs",
  ];
  let phraseIndex = 0;
  const rotEl = document.getElementById("heroRotating");
  const dotEl = document.getElementById("heroDot");
  const wrapEl = document.querySelector(".hero-rotating-wrap");

  /* Place le point juste après le wrap, sans animation au premier render */
  function moveDot(animate) {
    if (!dotEl || !wrapEl) return;
    if (!animate) dotEl.style.transition = "none";
    dotEl.style.left = wrapEl.offsetWidth + "px";
    if (!animate) requestAnimationFrame(() => { dotEl.style.transition = ""; });
  }

  if (rotEl) {
    rotEl.classList.add("is-entering");
    /* Position initiale sans transition */
    requestAnimationFrame(() => moveDot(false));

    setInterval(() => {
      rotEl.classList.remove("is-entering");
      rotEl.classList.add("is-leaving");

      setTimeout(() => {
        phraseIndex = (phraseIndex + 1) % phrases.length;
        rotEl.textContent = phrases[phraseIndex];
        rotEl.classList.remove("is-leaving");
        rotEl.classList.add("is-entering");
        /* Glisse le point vers la nouvelle position, en même temps que le texte entre */
        requestAnimationFrame(() => moveDot(true));
      }, 380);

    }, 2500);
  }

  /* Suivi de la souris — lerp fluide sur le fond */
  const bg = document.getElementById("heroBg");
  if (bg) {
    let tx = 50, ty = 62;   // position cible
    let cx = 50, cy = 62;   // position courante (lissée)
    const EASE = 0.06;       // 0 = aucun mouvement, 1 = instantané

    document.addEventListener("mousemove", (e) => {
      tx = (e.clientX / window.innerWidth)  * 100;
      ty = (e.clientY / window.innerHeight) * 100;
    });

    /* Retour au centre quand la souris quitte la fenêtre */
    document.addEventListener("mouseleave", () => {
      tx = 50; ty = 62;
    });

    (function animate() {
      cx += (tx - cx) * EASE;
      cy += (ty - cy) * EASE;
      bg.style.setProperty("--hx", cx.toFixed(2) + "%");
      bg.style.setProperty("--hy", cy.toFixed(2) + "%");
      requestAnimationFrame(animate);
    })();
  }

  /* Smooth scroll sur la flèche hero */
  const scrollBtn = document.querySelector('.hero-scroll');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.getElementById('hero-end');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>








