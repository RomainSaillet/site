---
import Base from '../layouts/Base.astro';
---
<Base
  title="Romain Saillet — Éditorial, enseignement, et un peu de code."
  description="Expert en création éditoriale et nouveaux médias. Directeur Conseil Éditorial chez Mantu, enseignant à Paris Panthéon-Assas, créateur de Storygami et Gist It."
  activeNav="accueil"
>

  <!-- ═══ HERO ═══ -->
  <section class="hero-fs">

    <div class="hero-bg" id="heroBg"></div>

    <div class="hero-body container">
      <div class="hero-text">
        <p class="hero-eyebrow">Romain Saillet · Paris</p>
        <h1 class="hero-title">
          Des histoires mémorables pour
          <span class="hero-rotating-line">
            <span class="hero-rotating-wrap">
              <span class="hero-rotating-text" id="heroRotating">engager vos audiences</span>
            </span><span class="hero-dot">.</span>
          </span>
        </h1>
        <a href="/contact" class="hero-cta">Me contacter →</a>
      </div>
    </div>

    <nav class="hero-socials">
      <a href="https://www.linkedin.com/in/romainsaillet/" target="_blank" rel="noopener">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        LinkedIn
      </a>
      <a href="mailto:romain@storytailor.fr">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        Email
      </a>
      <a href="https://youtube.com" target="_blank" rel="noopener">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><polygon points="10 15 15 12 10 9"/></svg>
        YouTube
      </a>
    </nav>

    <div class="hero-badge">TEDx Speaker</div>

    <a href="#hero-end" class="hero-scroll" aria-label="Défiler vers le contenu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
    </a>

  </section>
  <div id="hero-end"></div>

  <!-- ═══ CE QUE JE FAIS ═══ -->
  <section class="container section">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">Ce que je fais</div>
        <h2 class="section-title">Trois manières d'aborder le même problème</h2>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
      <a class="project-card" href="/storygami">
        <span class="tag tag-tool" style="align-self:flex-start;">Méthode</span>
        <h3 class="pc-title">Storygami</h3>
        <p class="pc-dek">Une méthodologie de stratégie éditoriale en six plis. Le canvas que j'utilise depuis douze ans pour structurer un récit de marque sans le rigidifier.</p>
        <span class="pc-foot">Voir la méthode →</span>
      </a>
      <a class="project-card" href="/gistit">
        <span class="tag tag-tool" style="align-self:flex-start;">Outil</span>
        <h3 class="pc-title">Gist It</h3>
        <p class="pc-dek">Une petite app macOS pour transcrire ce qu'on entend. Pensée pour les journalistes, les chercheurs et les paresseux méthodiques.</p>
        <span class="pc-foot">Découvrir l'app →</span>
      </a>
    </div>
  </section>

  <!-- ═══ CHIFFRE ÉDITORIAL ═══ -->
  <section class="container editorial-statement">
    <div class="grid">
      <div class="num">12<small>années à raconter</small></div>
      <p class="copy">Douze ans d'agence, et le sentiment que <em>ça commence à peine</em>. La technologie change les outils ; elle ne change pas la question.</p>
    </div>
  </section>

  <!-- ═══ DERNIERS ARTICLES ═══ -->
  <section class="container section" style="border-top:none;padding-top:0;">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">Derniers articles</div>
        <h2 class="section-title">Ce que j'ai écrit récemment</h2>
      </div>
      <a class="section-link" href="/blog">Tous les articles →</a>
    </div>
    <a class="article-card" href="/blog/ia-ecrira-pas-votre-livre">
      <div class="ac-cover storygami"></div>
      <div>
        <div class="ac-meta">Tribune<span class="sep"></span>12 min<span class="sep"></span>novembre 2025</div>
        <h3 class="ac-title">Pourquoi l'IA n'écrira pas votre prochain livre (et c'est tant mieux)</h3>
        <p class="ac-dek">Une grammaire ne fait pas un récit. Un récit ne fait pas un livre. Et un livre n'est rien sans le lecteur qu'il choisit.</p>
      </div>
    </a>
    <a class="article-card" href="/blog/nouveaux-medias-nouveaux-recits">
      <div class="ac-cover tedx"></div>
      <div>
        <div class="ac-meta">Tribune<span class="sep"></span>8 min<span class="sep"></span>septembre 2025</div>
        <h3 class="ac-title">Les nouveaux médias n'existent pas. Il n'y a que de nouveaux récits.</h3>
        <p class="ac-dek">Le mot « nouveau » est usé jusqu'à la corde. Ce qui change vraiment, ce n'est pas le canal.</p>
      </div>
    </a>
    <a class="article-card" href="/blog/enseigner-editorial-chatgpt">
      <div class="ac-cover teach"></div>
      <div>
        <div class="ac-meta">Cours<span class="sep"></span>6 min<span class="sep"></span>juin 2025</div>
        <h3 class="ac-title">Enseigner l'éditorial à des étudiants nés avec ChatGPT</h3>
        <p class="ac-dek">Retour sur un semestre à Paris Panthéon-Assas. Ce que mes étudiants m'ont appris vaut largement ce que je leur ai transmis.</p>
      </div>
    </a>
  </section>

  <!-- ═══ CITATION ═══ -->
  <section class="container section">
    <blockquote class="pullquote" style="max-width:32rem;">
      « Une marque qui n'a plus rien à raconter n'a plus rien à vendre. C'est aussi vrai d'une personne. »
      <cite>Storygami — chapitre I</cite>
    </blockquote>
  </section>

</Base>

<style>
  /* ══════════════════════════════════
     HERO — variables CSS par thème
  ══════════════════════════════════ */

  /* Mode sombre (défaut) */
  .hero-fs {
    --hero-base-start : #1c0f0a;
    --hero-base-end   : #18160F; /* = --paper dark, assure la continuité */
    --hero-orb-color  : rgba(170, 80, 50, 0.60);
    --hero-orb-mid    : rgba(100, 38, 20, 0.30);
    --hero-glow-color : rgba(210, 115, 65, 0.18);
    --hero-text       : #ffffff;
    --hero-text-dim   : rgba(255,255,255,0.50);
    --hero-cta-bg     : rgba(255,255,255,0.10);
    --hero-cta-border : rgba(255,255,255,0.22);
    --hero-cta-hover  : rgba(255,255,255,0.18);
  }

  /* Mode clair */
  :global([data-theme="light"]) .hero-fs {
    --hero-base-start : #fdf6ee;
    --hero-base-end   : #f5ece0;
    --hero-orb-color  : rgba(200, 130, 70, 0.35);
    --hero-orb-mid    : rgba(180, 100, 50, 0.15);
    --hero-glow-color : rgba(220, 155, 90, 0.20);
    --hero-text       : #1a0f0a;
    --hero-text-dim   : rgba(26, 15, 10, 0.45);
    --hero-cta-bg     : rgba(26, 15, 10, 0.07);
    --hero-cta-border : rgba(26, 15, 10, 0.18);
    --hero-cta-hover  : rgba(26, 15, 10, 0.13);
  }

  /* ── Structure ── */
  .hero-fs {
    position: relative;
    height: 100vh;
    min-height: 620px;
    overflow: hidden;
  }

  /* Fondu bas vers la couleur de page — seamless en dark & light */
  .hero-fs::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 180px;
    background: linear-gradient(to bottom,
      transparent,
      var(--hero-base-end)
    );
    pointer-events: none;
  }

  /* ── Fond réactif à la souris via CSS custom props ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 70% 55% at var(--hx, 50%) var(--hy, 62%),
        var(--hero-orb-color) 0%,
        var(--hero-orb-mid)   38%,
        transparent           70%
      ),
      radial-gradient(
        ellipse 40% 30% at var(--hx, 50%) var(--hy, 62%),
        var(--hero-glow-color) 0%,
        transparent 100%
      ),
      linear-gradient(160deg,
        var(--hero-base-start) 0%,
        var(--hero-base-end)   100%
      );
    transition: background 0.4s ease;
  }

  /* ── Texte ── */
  .hero-body {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  .hero-text {
    max-width: 680px;
    padding-top: 60px;
    text-align: left;
  }
  .hero-eyebrow {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hero-text-dim);
    margin-bottom: 24px;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--hero-text);
    margin-bottom: 40px;
  }
  .hero-cta {
    display: inline-block;
    padding: 13px 28px;
    background: var(--hero-cta-bg);
    border: 1px solid var(--hero-cta-border);
    color: var(--hero-text);
    font-weight: 500;
    font-size: 14px;
    border-radius: 4px;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: background 0.2s, border-color 0.2s;
  }
  .hero-cta:hover {
    background: var(--hero-cta-hover);
  }

  /* ── Liens sociaux — bas gauche ── */
  .hero-socials {
    position: absolute;
    bottom: 44px;
    left: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hero-socials a {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--hero-text-dim);
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .hero-socials a:hover { color: var(--hero-text); }

  /* ── Badge TEDx — droite ── */
  .hero-badge {
    position: absolute;
    top: 50%;
    right: -22px;
    transform: translateY(-50%) rotate(90deg);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--hero-text-dim);
    white-space: nowrap;
  }

  /* ── Flèche scroll — bas centre ── */
  .hero-scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--hero-text-dim);
    text-decoration: none;
    animation: bounce 2.4s ease-in-out infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }

  /* ── Texte rotatif ── */

  /* Couleur accent selon le thème */
  .hero-fs { --hero-accent: #C96848; } /* ember — fonctionne dark & light */

  /* Ligne qui contient le texte rotatif + le point */
  .hero-rotating-line {
    display: block;
  }

  /* Fenêtre de clip — seule la hauteur d'une ligne est visible */
  .hero-rotating-wrap {
    display: inline-block;
    overflow: hidden;
    height: 1.15em;
    vertical-align: bottom;
  }

  .hero-rotating-text {
    display: block;
    color: var(--hero-accent);
  }

  /* Point final en couleur charte, toujours visible */
  .hero-dot {
    display: inline;
    vertical-align: bottom;
    line-height: 1.15em;
    color: var(--hero-accent);
    font-weight: 700;
  }

  .hero-rotating-text.is-entering {
    animation: rotateIn 0.45s cubic-bezier(0.2, 0, 0, 1) forwards;
  }
  .hero-rotating-text.is-leaving {
    animation: rotateOut 0.35s cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  @keyframes rotateIn {
    from { transform: translateY(110%); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }
  @keyframes rotateOut {
    from { transform: translateY(0);     opacity: 1; }
    to   { transform: translateY(-110%); opacity: 0; }
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .hero-socials, .hero-badge { display: none; }
    .hero-title { font-size: 1.9rem; }
    .hero-rotating-wrap { height: 1.2em; }
  }
</style>

<script>
  /* ── Texte rotatif ── */
  const phrases = [
    "engager vos audiences",
    "développer votre marque",
    "trouver vos clients",
    "embaucher les meilleurs talents",
    "inspirer vos équipes",
    "convaincre vos investisseurs",
  ];
  let phraseIndex = 0;
  const rotEl = document.getElementById("heroRotating");

  if (rotEl) {
    rotEl.classList.add("is-entering");

    setInterval(() => {
      // Sortie
      rotEl.classList.remove("is-entering");
      rotEl.classList.add("is-leaving");

      setTimeout(() => {
        phraseIndex = (phraseIndex + 1) % phrases.length;
        rotEl.textContent = phrases[phraseIndex];
        rotEl.classList.remove("is-leaving");
        rotEl.classList.add("is-entering");
      }, 380); // durée de rotateOut

    }, 2500); // 2s visible + 0.5s transition
  }

  /* Suivi de la souris — lerp fluide sur le fond */
  const bg = document.getElementById("heroBg");
  if (bg) {
    let tx = 50, ty = 62;   // position cible
    let cx = 50, cy = 62;   // position courante (lissée)
    const EASE = 0.06;       // 0 = aucun mouvement, 1 = instantané

    document.addEventListener("mousemove", (e) => {
      tx = (e.clientX / window.innerWidth)  * 100;
      ty = (e.clientY / window.innerHeight) * 100;
    });

    /* Retour au centre quand la souris quitte la fenêtre */
    document.addEventListener("mouseleave", () => {
      tx = 50; ty = 62;
    });

    (function animate() {
      cx += (tx - cx) * EASE;
      cy += (ty - cy) * EASE;
      bg.style.setProperty("--hx", cx.toFixed(2) + "%");
      bg.style.setProperty("--hy", cy.toFixed(2) + "%");
      requestAnimationFrame(animate);
    })();
  }
</script>



